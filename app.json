{
  "name": "TG_TAG Telegram Bot",
  "description": "A multi-purpose Telegram bot with AI, media, utility, and database features.",
  "repository": "https://github.com/Ultar12/TG_TAG",
  "keywords": [
    "telegram",
    "telegram-bot",
    "python",
    "ai",
    "media"
  ],
  "buildpacks": [
    {
      "url": "https://github.com/heroku/heroku-buildpack-activestorage-preview.git"
    },
    {
      "url": "https://github.com/heroku/heroku-buildpack-apt"
    },
    {
      "url": "heroku/nodejs"
    },
    {
      "url": "heroku/python"
    }
  ],
  "env": {
    "BOT_TOKEN": {
      "description": "Telegram bot token from BotFather.",
      "required": true
    },
    "DATABASE_URL": {
      "description": "PostgreSQL connection URL.",
      "required": true
    },
    "ADMIN_ID": {
      "description": "Numeric Telegram user ID for the bot administrator.",
      "required": true
    },
    "OPENAI_API_KEY": {
      "description": "Optional OpenAI API key for image generation.",
      "required": false
    },
    "REPLICATE_API_TOKEN": {
      "description": "Optional Replicate API token.",
      "required": false
    },
    "STABILITY_API_KEY": {
      "description": "Optional Stability AI API key.",
      "required": false
    },
    "OPENWEATHER_API_KEY": {
      "description": "Optional OpenWeather API key.",
      "required": false
    },
    "SCREENSHOT_API_KEY": {
      "description": "Optional screenshot API key.",
      "required": false
    },
    "TMDB_API_KEY": {
      "description": "Optional TMDB API key.",
      "required": false
    },
    "ELEVENLABS_API_KEY": {
      "description": "ElevenLabs API key for consent-based voice cloning and high-quality voice notes.",
      "required": false
    },
    "ELEVENLABS_TTS_MODEL": {
      "description": "Optional ElevenLabs TTS model. Defaults to eleven_multilingual_v2.",
      "value": "eleven_multilingual_v2",
      "required": false
    },
    "AGENTROUTER_API_KEY": {
      "description": "AgentRouter API key for the /ai command.",
      "required": false
    },
    "AGENTROUTER_BASE_URL": {
      "description": "AgentRouter OpenAI-compatible base URL.",
      "value": "https://co.agentrouter.org/v1",
      "required": false
    },
    "AGENTROUTER_MODEL": {
      "description": "AgentRouter model used by /ai.",
      "value": "claude-opus-4-8",
      "required": false
    },
    "ANTHROPIC_AUTH_TOKEN": {
      "description": "Anthropic-compatible AgentRouter token used by /ai when configured.",
      "required": false
    },
    "ANTHROPIC_BASE_URL": {
      "description": "Anthropic-compatible AgentRouter base URL.",
      "value": "https://agentrouter.org",
      "required": false
    },
    "ANTHROPIC_MODEL": {
      "description": "Anthropic-compatible AgentRouter model used by /ai.",
      "value": "claude-opus-5",
      "required": false
    },
    "GMAIL_ADDRESS": {
      "description": "Optional Gmail address for the admin email feature.",
      "required": false
    },
    "GMAIL_APP_PASSWORD": {
      "description": "Optional Gmail app password.",
      "required": false
    },
    "WEBHOOK_URL": {
      "description": "Public HTTPS base URL of the Heroku app, for example https://your-app.herokuapp.com.",
      "required": true
    },
    "WEBHOOK_SECRET_TOKEN": {
      "description": "Optional Telegram webhook secret token.",
      "required": false
    }
  },
  "formation": {
    "web": {
      "quantity": 1
    },
    "worker": {
      "quantity": 0
    }
  }
}
