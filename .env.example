# Required Telegram settings
BOT_TOKEN=replace_with_botfather_token
ADMIN_ID=replace_with_numeric_telegram_user_id

# YouTube listener: uses ADMIN_ID when YOUTUBE_LISTENER_CHAT_ID is omitted
YOUTUBE_LISTENER_CHANNEL=@helenefischer
YOUTUBE_LISTENER_INTERVAL=3600
# YOUTUBE_LISTENER_CHAT_ID=
YTDL_COOKIES_FILE=/etc/secrets/cookies_youtube.txt
YOUTUBE_CLIENT_ID=replace_with_google_oauth_client_id
YOUTUBE_CLIENT_SECRET=replace_with_google_oauth_client_secret
YOUTUBE_REFRESH_TOKEN=replace_with_google_oauth_refresh_token
YOUTUBE_OAUTH_SETUP_TOKEN=choose_a_long_random_setup_token
YOUTUBE_AUTO_UPLOAD=false
YOUTUBE_UPLOAD_PRIVACY=private

# Optional existing services
DATABASE_URL=postgresql://user:password@host:5432/database
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_STT_MODEL=scribe_v1
WEBHOOK_URL=https://your-app.herokuapp.com
WEBHOOK_SECRET_TOKEN=
